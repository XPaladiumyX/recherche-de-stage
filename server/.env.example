# ---------------------------------------------------------------------------
# Configuration du serveur d'envoi · NE JAMAIS COMMITER CE FICHIER
# Copie ce fichier en `.env` puis remplis tes informations.
# ---------------------------------------------------------------------------

# Serveur local (garde 127.0.0.1 : accessible uniquement depuis ton PC)
HOST=127.0.0.1
PORT=3001

# Gmail : SMTP_PROVIDER=gmail
# Outlook / Office 365 : SMTP_PROVIDER=outlook
# Autre fournisseur SMTP : SMTP_PROVIDER=custom
SMTP_PROVIDER=gmail

# Gmail (mot de passe d'application, PAS ton mot de passe habituel)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=le-mot-de-passe-application-google

# Outlook / Office 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ton.adresse@outlook.fr
# SMTP_PASS=le-mot-de-passe-application

# Adresse visible dans les mails (doit correspondre au compte SMTP)
FROM_EMAIL=ton.adresse@gmail.com
FROM_NAME=Ton Prénom Nom

# Quota et rythme (recommandé : 30-50 mails/jour)
MAX_PER_DAY=40
DELAY_MIN_SECONDS=45
DELAY_MAX_SECONDS=90

# Mode simulation : true = aucun mail réel n'est envoyé (pour tester l'interface)
# Passe à false quand ta configuration SMTP est prête.
DRY_RUN=true

# Origines autorisées à appeler l'API (le site GitHub Pages + le serveur local)
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://xpaladiumyx.github.io
